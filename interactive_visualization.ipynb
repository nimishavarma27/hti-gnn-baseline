{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Interactive HTI Network Visualizations\n",
    "\n",
    "Produces several interactive HTML network graphs using PyVis.\n",
    "Open each HTML file in a browser (Chrome / Firefox / Edge).\n",
    "\n",
    "**Outputs** (written to `hti_out/figures_interactive/`):\n",
    "- `view1_full_HC.html` - full herb to compound bipartite (62 + 2,319 nodes)\n",
    "- `view2_CT_top50_targets.html` - compound to target restricted to top-50 targets\n",
    "- `view3_HCT_top10_herbs.html` - full H to C to T restricted to top-10 herbs\n",
    "- `view4_herb_<name>.html` - per-herb neighborhood explorer (top 5 herbs)\n",
    "\n",
    "**Interactive features in each HTML:**\n",
    "- scroll to zoom, drag to pan\n",
    "- hover any node for tooltip\n",
    "- drag nodes to reposition\n",
    "- physics simulation can be paused via the control panel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# install if missing (uncomment the next line the first time)\n",
    "# !pip install pyvis\n",
    "\n",
    "import os\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "from pyvis.network import Network\n",
    "\n",
    "DATA_DIR = r\"C:\\Users\\Nimishavarma\\OneDrive\\Dokumenty\"\n",
    "OUT_DIR  = os.path.join(os.getcwd(), \"hti_out\", \"figures_interactive\")\n",
    "os.makedirs(OUT_DIR, exist_ok=True)\n",
    "\n",
    "# color scheme (matches the matplotlib notebook)\n",
    "HERB_COLOR     = \"#4C72B0\"\n",
    "COMPOUND_COLOR = \"#DD8452\"\n",
    "TARGET_COLOR   = \"#8172B2\"\n",
    "\n",
    "print(\"Output HTMLs will go to:\", OUT_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# load the data\n",
    "lab  = pd.read_csv(os.path.join(DATA_DIR, \"compound_target_labeled.csv\"))\n",
    "hct  = pd.read_csv(os.path.join(DATA_DIR, \"herb_compound_target.csv\"))\n",
    "hce  = pd.read_csv(os.path.join(DATA_DIR, \"herb_compound_edges.tsv\"), sep=\"\\t\")\n",
    "\n",
    "# useful lookups\n",
    "herb_name  = hce.drop_duplicates(\"herb_id\").set_index(\"herb_id\")[\"botanical_name\"].to_dict()\n",
    "gene_sym   = lab.drop_duplicates(\"protein_id\").set_index(\"protein_id\")[\"hgnc_symbol\"].to_dict()\n",
    "protein_nm = lab.drop_duplicates(\"protein_id\").set_index(\"protein_id\").get(\"hgnc_symbol\", {}).to_dict() if \"hgnc_symbol\" in lab.columns else {}\n",
    "\n",
    "print(f\"loaded: {len(hce):,} H-C rows, {len(lab):,} C-T positives, {len(hct):,} H-C-T paths\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def new_network(height=\"900px\", width=\"100%\"):\n",
    "    \"\"\"Create a PyVis Network with sensible defaults for a scientific graph.\"\"\"\n",
    "    net = Network(height=height, width=width, bgcolor=\"#ffffff\",\n",
    "                  font_color=\"#111111\", notebook=False, cdn_resources=\"in_line\",\n",
    "                  directed=False)\n",
    "    net.barnes_hut(gravity=-2500, central_gravity=0.1,\n",
    "                   spring_length=120, spring_strength=0.02,\n",
    "                   damping=0.09)\n",
    "    net.show_buttons(filter_=[\"physics\"])\n",
    "    return net\n",
    "\n",
    "def add_herb(net, hid, size=35):\n",
    "    label = herb_name.get(hid, hid)\n",
    "    net.add_node(hid, label=label, title=f\"HERB\\n{label}\",\n",
    "                 color=HERB_COLOR, size=size, shape=\"dot\", font={\"size\": 18, \"bold\": True})\n",
    "\n",
    "def add_compound(net, cid, size=12):\n",
    "    short = cid.replace(\"IMPPAT3_PHYID\", \"PHY\")\n",
    "    net.add_node(cid, label=\"\", title=f\"COMPOUND\\n{cid}\",\n",
    "                 color=COMPOUND_COLOR, size=size, shape=\"dot\")\n",
    "\n",
    "def add_target(net, pid, size=14):\n",
    "    sym = gene_sym.get(pid, pid.split(\":\")[-1])\n",
    "    net.add_node(pid, label=sym, title=f\"TARGET\\n{sym} ({pid})\",\n",
    "                 color=TARGET_COLOR, size=size, shape=\"dot\", font={\"size\": 10})\n",
    "\n",
    "print(\"helpers ready\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## View 1 - Full H to C bipartite (62 herbs + all compounds they contain)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "net1 = new_network()\n",
    "hc_edges = hce.drop_duplicates([\"herb_id\", \"compound_id\"])\n",
    "\n",
    "for hid in hc_edges[\"herb_id\"].unique():\n",
    "    add_herb(net1, hid, size=25)\n",
    "for cid in hc_edges[\"compound_id\"].unique():\n",
    "    add_compound(net1, cid, size=6)\n",
    "for _, r in hc_edges.iterrows():\n",
    "    net1.add_edge(r[\"herb_id\"], r[\"compound_id\"], color=\"#cccccc\", width=0.5)\n",
    "\n",
    "out1 = os.path.join(OUT_DIR, \"view1_full_HC.html\")\n",
    "net1.save_graph(out1)\n",
    "print(f\"saved {out1}  ({net1.num_nodes()} nodes, {net1.num_edges()} edges)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## View 2 - Compound to top-50 targets (compound promiscuity)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "net2 = new_network()\n",
    "top50_tgt = (lab.groupby(\"protein_id\").size()\n",
    "                .sort_values(ascending=False).head(50).index.tolist())\n",
    "ct_sub = lab[lab[\"protein_id\"].isin(top50_tgt)]\n",
    "\n",
    "for pid in top50_tgt:\n",
    "    add_target(net2, pid, size=22)\n",
    "for cid in ct_sub[\"compound_id\"].unique():\n",
    "    add_compound(net2, cid, size=6)\n",
    "for _, r in ct_sub.iterrows():\n",
    "    net2.add_edge(r[\"compound_id\"], r[\"protein_id\"], color=\"#cccccc\", width=0.4)\n",
    "\n",
    "out2 = os.path.join(OUT_DIR, \"view2_CT_top50_targets.html\")\n",
    "net2.save_graph(out2)\n",
    "print(f\"saved {out2}  ({net2.num_nodes()} nodes, {net2.num_edges()} edges)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## View 3 - Full H to C to T for top-10 herbs (the hero visual)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "net3 = new_network()\n",
    "\n",
    "top10_herbs = (hct.groupby(\"herb_id\").size()\n",
    "                  .sort_values(ascending=False).head(10).index.tolist())\n",
    "sub_hct = hct[hct[\"herb_id\"].isin(top10_herbs)]\n",
    "\n",
    "for hid in top10_herbs:\n",
    "    add_herb(net3, hid, size=40)\n",
    "for cid in sub_hct[\"compound_id\"].unique():\n",
    "    add_compound(net3, cid, size=8)\n",
    "for pid in sub_hct[\"protein_id\"].unique():\n",
    "    add_target(net3, pid, size=14)\n",
    "\n",
    "# H-C edges\n",
    "for _, r in sub_hct.drop_duplicates([\"herb_id\",\"compound_id\"]).iterrows():\n",
    "    net3.add_edge(r[\"herb_id\"], r[\"compound_id\"],\n",
    "                  color=\"#4C72B055\", width=0.5)\n",
    "# C-T edges\n",
    "for _, r in sub_hct.drop_duplicates([\"compound_id\",\"protein_id\"]).iterrows():\n",
    "    net3.add_edge(r[\"compound_id\"], r[\"protein_id\"],\n",
    "                  color=\"#8172B255\", width=0.4)\n",
    "\n",
    "out3 = os.path.join(OUT_DIR, \"view3_HCT_top10_herbs.html\")\n",
    "net3.save_graph(out3)\n",
    "print(f\"saved {out3}  ({net3.num_nodes()} nodes, {net3.num_edges()} edges)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## View 4 - Per-herb explorer (one HTML per top-5 herb)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "top5_herbs = (hct.groupby(\"herb_id\").size()\n",
    "                 .sort_values(ascending=False).head(5).index.tolist())\n",
    "\n",
    "for hid in top5_herbs:\n",
    "    net = new_network(height=\"800px\")\n",
    "    sub = hct[hct[\"herb_id\"] == hid]\n",
    "    name = herb_name[hid].replace(\" \", \"_\")\n",
    "\n",
    "    add_herb(net, hid, size=55)\n",
    "    for cid in sub[\"compound_id\"].unique():\n",
    "        add_compound(net, cid, size=10)\n",
    "    for pid in sub[\"protein_id\"].unique():\n",
    "        add_target(net, pid, size=16)\n",
    "    for _, r in sub.drop_duplicates([\"herb_id\",\"compound_id\"]).iterrows():\n",
    "        net.add_edge(r[\"herb_id\"], r[\"compound_id\"], color=\"#4C72B077\", width=0.6)\n",
    "    for _, r in sub.drop_duplicates([\"compound_id\",\"protein_id\"]).iterrows():\n",
    "        net.add_edge(r[\"compound_id\"], r[\"protein_id\"], color=\"#8172B277\", width=0.5)\n",
    "\n",
    "    out = os.path.join(OUT_DIR, f\"view4_herb_{name}.html\")\n",
    "    net.save_graph(out)\n",
    "    print(f\"saved {out}  ({net.num_nodes()} nodes, {net.num_edges()} edges)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"All interactive HTMLs saved to:\", OUT_DIR)\n",
    "for f in sorted(os.listdir(OUT_DIR)):\n",
    "    size_mb = os.path.getsize(os.path.join(OUT_DIR, f)) / 1024 / 1024\n",
    "    print(f\"  {f}  ({size_mb:.1f} MB)\")\n",
    "print(\"\\nOpen any file in a browser (Chrome/Firefox/Edge) to interact.\")"
   ]
  }
 ],
